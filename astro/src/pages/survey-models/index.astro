---
import DefaultMainLayout from '@layouts/DefaultMainLayout.astro';
import EmptyState from '@components/ui/EmptyState.astro';
import assert from 'node:assert';
import { createSurveyModelService } from '@lib/composition.ts';

const { user } = Astro.locals;
assert(user, 'User must be logged in.');

const surveyModelService = createSurveyModelService(Astro.locals);
const surveyModels = await surveyModelService.getAllSurveyModels();
---

<DefaultMainLayout title="Survey Models">
  <div class="space-y-6">
    <h1 class="text-3xl font-bold">Survey Models</h1>

    {
      surveyModels.length === 0 ? (
        <div class="card bg-base-100 shadow-md">
          <div class="card-body">
            <EmptyState icon="document" title="No survey models available" />
          </div>
        </div>
      ) : (
        <div
          data-testid="survey-models-grid"
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"
        >
          {surveyModels.map((model) => (
            <a
              href={`/survey-models/${model.id}`}
              class="card bg-base-100 border border-base-100 shadow-md hover:shadow-lg hover:border-primary/40 focus:outline-none focus:ring-2 focus:ring-primary/30 transition-all"
            >
              <div class="card-body">
                <h3 class="text-lg font-semibold">Version {model.version}</h3>
              </div>
            </a>
          ))}
        </div>
      )
    }
  </div>
</DefaultMainLayout>
