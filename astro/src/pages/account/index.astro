---
import DefaultMainLayout from '@layouts/DefaultMainLayout.astro';
import assert from 'node:assert';

const { user } = Astro.locals;
assert(user, 'User must be logged in.');
---

<DefaultMainLayout title="Account">
  <div class="space-y-6">
    <h1 class="text-3xl font-bold">Account</h1>

    <div class="card bg-base-100 shadow-md">
      <div class="card-body">
        <div class="flex flex-col items-center justify-center py-8 text-center">
          <span class="iconify lucide--settings h-12 w-12 opacity-50 mb-4"
          ></span>
          <p class="text-sm text-base-content/70 mb-4">
            Additional settings will be available here soon
          </p>
          <div class="flex gap-2">
            <button class="btn btn-sm opacity-50" disabled
              >Change Password</button
            >
            <button class="btn btn-sm opacity-50" disabled
              >Account Preferences</button
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</DefaultMainLayout>
