---
import DefaultMainLayout from '@layouts/DefaultMainLayout.astro';
import EmptyState from '@components/ui/EmptyState.astro';
import assert from 'node:assert';
import { createDoraCapabilitiesService } from '@lib/composition.ts';

const { user } = Astro.locals;
assert(user, 'User must be logged in.');

const doraCapabilitiesService = createDoraCapabilitiesService(Astro.locals);
const capabilities = await doraCapabilitiesService.getAllDoraCapabilities();
---

<DefaultMainLayout title="DORA Capabilities">
  <div class="space-y-6">
    <h1 class="text-3xl font-bold">DORA Capabilities</h1>

    {
      capabilities.length === 0 ? (
        <div class="card bg-base-100 shadow-md">
          <div class="card-body">
            <EmptyState
              icon="document"
              title="No DORA capabilities available"
            />
          </div>
        </div>
      ) : (
        <div
          data-testid="dora-capabilities-grid"
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"
        >
          {capabilities.map((capability) => (
            <a
              href={`/dora-capabilities/${capability.id}`}
              data-testid="dora-capability-item"
              class="card bg-base-100 border border-base-100 shadow-md hover:shadow-lg hover:border-primary/40 focus:outline-none focus:ring-2 focus:ring-primary/30 transition-all"
            >
              <div class="card-body">
                <h2 class="card-title" data-testid="dora-capability-name">
                  {capability.name}
                </h2>
              </div>
            </a>
          ))}
        </div>
      )
    }
  </div>
</DefaultMainLayout>
