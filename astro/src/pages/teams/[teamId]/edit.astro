---
import ModalLayout from '@layouts/ModalLayout.astro';
import Alert from '@components/ui/Alert.astro';
import { actions } from 'astro:actions';
import assert from 'node:assert';
import { AuthorizationError } from '@services/authorization-service.ts';
import type { TeamDto } from '@services/teams-service.ts';
import { createTeamsService } from '@lib/composition.ts';

const { user } = Astro.locals;
assert(user, 'User must be logged in.');

const { teamId } = Astro.params as { teamId: string };

let team: TeamDto | null = null;
let notAuthorized = false;
let notTeamLead = false;

try {
  const teamsService = createTeamsService(Astro.locals);
  team = await teamsService.getTeam(teamId);

  const teamLeads = team.members.filter((m) => m.role === 'team-lead');
  const isTeamLead = teamLeads.some((m) => m.userId === user.id);

  if (!isTeamLead) {
    notTeamLead = true;
  }
} catch (error) {
  if (error instanceof AuthorizationError) {
    notAuthorized = true;
  } else {
    return new Response('Not Found', { status: 404 });
  }
}

const result = Astro.getActionResult(actions.updateTeam);
if (result?.data?.success) {
  return Astro.redirect(`/teams/${teamId}`);
}
---

<ModalLayout title="Edit Team">
  {
    notAuthorized || notTeamLead ? (
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h1 class="card-title text-2xl">Access Denied</h1>
          <Alert type="warning">
            You do not have permission to edit this team. Only team leads can
            edit team details.
          </Alert>
          <div class="card-actions justify-end">
            <a href={`/teams/${teamId}`} class="btn btn-primary">
              Back to Team Details
            </a>
          </div>
        </div>
      </div>
    ) : (
      team && (
        <>
          {result?.error && (
            <Alert type="error" messageClass="error-message">
              {result.error.message}
            </Alert>
          )}

          <form
            id="edit-team-form"
            method="POST"
            action={actions.updateTeam}
            class="space-y-4"
          >
            <input type="hidden" name="teamId" value={team.id} />

            <div class="space-y-2">
              <label class="label" for="name">
                Team Name
              </label>
              <input
                type="text"
                id="name"
                name="name"
                value={team.name}
                required
                minlength="3"
                maxlength="100"
                class="input w-full"
              />
            </div>

            <div class="space-y-2">
              <label class="label" for="description">
                Description
              </label>
              <textarea
                id="description"
                name="description"
                class="textarea w-full"
              >
                {team.description ?? ''}
              </textarea>
            </div>
          </form>
        </>
      )
    )
  }
  <div slot="actions" class="flex flex-1 justify-center">
    <a href={`/teams/${teamId}`} class="btn btn-ghost"> Cancel </a>
    <button type="submit" form="edit-team-form" class="btn btn-primary">
      Save Changes
    </button>
  </div>
</ModalLayout>
