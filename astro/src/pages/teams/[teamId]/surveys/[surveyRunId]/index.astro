---
import DefaultMainLayout from '@layouts/DefaultMainLayout.astro';
import Alert from '@components/ui/Alert.astro';
import EmptyState from '@components/ui/EmptyState.astro';
import { actions } from 'astro:actions';
import assert from 'node:assert';
import { AuthorizationError } from '@services/authorization-service.ts';
import type { AssessmentResult } from '@models/aggregates/assessment-result.ts';
import SurveyRunResponseSection from '@components/survey-run/SurveyRunResponseSection.astro';
import SurveyRunAssessmentSection from '@components/survey-run/SurveyRunAssessmentSection.astro';
import { createGetSurveyRunDetailsUseCase } from '@lib/composition.ts';
import {
  SurveyRunDetailsNotFoundError,
  type SurveyRunDetails,
} from '@use-cases/get-survey-run-details.ts';

const { user } = Astro.locals;
assert(user, 'User must be logged in.');

const { teamId, surveyRunId } = Astro.params as {
  teamId: string;
  surveyRunId: string;
};
let surveyRunDetails: SurveyRunDetails | null = null;
let notAuthorized = false;

try {
  surveyRunDetails = await createGetSurveyRunDetailsUseCase(
    Astro.locals,
  ).execute(teamId, surveyRunId, user.id);
} catch (error) {
  if (error instanceof AuthorizationError) {
    notAuthorized = true;
  } else if (error instanceof SurveyRunDetailsNotFoundError) {
    return new Response('Not Found', { status: 404 });
  } else {
    return new Response('Not Found', { status: 404 });
  }
}

const surveyRun = surveyRunDetails?.surveyRun ?? null;
const team = surveyRunDetails?.team ?? null;
const isTeamLead = surveyRunDetails?.isTeamLead ?? false;
const hasOtherOpenSurveyRun = surveyRunDetails?.hasOtherOpenSurveyRun ?? false;
const assessmentResult: AssessmentResult | null =
  surveyRunDetails?.assessmentResult ?? null;
const assessmentError = surveyRunDetails?.assessmentError;
const questionAnswers = surveyRunDetails?.questionAnswers ?? [];

const breadcrumbs = team
  ? [
      { label: 'Home', href: '/' },
      { label: team.name, href: `/teams/${teamId}` },
      { label: surveyRun?.title ?? 'Survey' },
    ]
  : undefined;
---

<DefaultMainLayout title="Survey Details" breadcrumbs={breadcrumbs}>
  <div class="space-y-6">
    {
      notAuthorized ? (
        <div class="card bg-base-100 shadow-md">
          <div class="card-body">
            <h1 class="card-title text-2xl">Access Denied</h1>
            <Alert type="warning">
              You do not have permission to view this survey run. Only team
              members can access this page.
            </Alert>
            <div class="card-actions justify-end">
              <a href="/" class="btn btn-primary">
                Back to Home
              </a>
            </div>
          </div>
        </div>
      ) : (
        surveyRun && (
          <div class="space-y-4">
            <div class="flex">
              <div class="flex-1 space-y-2">
                <h1 class="text-3xl font-bold">{surveyRun.title}</h1>
                <div>
                  <span
                    data-testid="survey-run-status"
                    class="badge badge-soft badge-info"
                  >
                    {surveyRun.status}
                  </span>
                </div>
              </div>
              {isTeamLead && surveyRun.status === 'pending' && (
                <form method="POST" action={actions.openSurveyRun}>
                  <input type="hidden" name="surveyRunId" value={surveyRunId} />
                  <span
                    class={hasOtherOpenSurveyRun ? 'tooltip tooltip-left' : ''}
                    data-tip={
                      hasOtherOpenSurveyRun
                        ? 'Another survey is currently open for this team. Close it before opening a new one.'
                        : undefined
                    }
                  >
                    <button
                      type="submit"
                      class="btn btn-soft gap-2"
                      disabled={hasOtherOpenSurveyRun}
                    >
                      <span class="iconify lucide--play" />
                      Open Survey
                    </button>
                  </span>
                </form>
              )}
              {isTeamLead && surveyRun.status === 'open' && (
                <form method="POST" action={actions.closeSurveyRun}>
                  <input type="hidden" name="surveyRunId" value={surveyRunId} />
                  <button type="submit" class="btn btn-soft gap-2">
                    <span class="iconify lucide--stop" />
                    Close Survey
                  </button>
                </form>
              )}
              {isTeamLead && surveyRun.status === 'closed' && (
                <form method="POST" action={actions.reopenSurveyRun}>
                  <input type="hidden" name="surveyRunId" value={surveyRunId} />
                  <span
                    class={hasOtherOpenSurveyRun ? 'tooltip tooltip-left' : ''}
                    data-tip={
                      hasOtherOpenSurveyRun
                        ? 'Another survey is currently open for this team. Close it before reopening this one.'
                        : undefined
                    }
                  >
                    <button
                      type="submit"
                      class="btn btn-soft gap-2"
                      disabled={hasOtherOpenSurveyRun}
                    >
                      <span class="iconify lucide--repeat-2" />
                      Reopen Survey
                    </button>
                  </span>
                </form>
              )}
            </div>

            {surveyRun.status === 'pending' && (
              <div class="card bg-base-100 shadow-md">
                <div class="card-body">
                  <EmptyState icon="hourglass" title="Survey not open yet" />
                </div>
              </div>
            )}

            {surveyRun.status === 'open' && (
              <SurveyRunResponseSection
                surveyRunId={surveyRunId}
                questionAnswers={questionAnswers}
              />
            )}

            {surveyRun.status === 'closed' && (
              <SurveyRunAssessmentSection
                surveyRun={surveyRun}
                assessmentError={assessmentError}
                assessmentResult={assessmentResult}
              />
            )}
          </div>
        )
      )
    }
  </div>
</DefaultMainLayout>
