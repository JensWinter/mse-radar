---
import DefaultMainLayout from '@layouts/DefaultMainLayout.astro';
import Alert from '@components/ui/Alert.astro';
import EmptyState from '@components/ui/EmptyState.astro';
import assert from 'node:assert';
import { AuthorizationError } from '@services/authorization-service.ts';
import {
  createGetTeamOverviewUseCase,
  createGetTeamTrendUseCase,
} from '@lib/composition.ts';
import {
  type TeamOverview,
  TeamOverviewNotFoundError,
} from '@use-cases/get-team-overview.ts';
import {
  type TeamTrend,
  TeamTrendNotFoundError,
} from '@use-cases/get-team-trend.ts';
import TrendGrid from '@components/trend/TrendGrid.astro';
import { actions } from 'astro:actions';

const { user } = Astro.locals;
assert(user, 'User must be logged in.');

const { teamId } = Astro.params as { teamId: string };

let teamOverview: TeamOverview | null = null;
let notAuthorized = false;

try {
  teamOverview = await createGetTeamOverviewUseCase(Astro.locals).execute(
    teamId,
    user.id,
  );
} catch (error) {
  if (error instanceof AuthorizationError) {
    notAuthorized = true;
  } else if (error instanceof TeamOverviewNotFoundError) {
    return new Response('Not Found', { status: 404 });
  } else {
    return new Response('Not Found', { status: 404 });
  }
}

let teamTrend: TeamTrend | null = null;

try {
  teamTrend = await createGetTeamTrendUseCase(Astro.locals).execute(teamId);
} catch (error) {
  if (error instanceof AuthorizationError) {
    notAuthorized = true;
  } else if (error instanceof TeamTrendNotFoundError) {
    return new Response('Not Found', { status: 404 });
  } else {
    return new Response('Not Found', { status: 404 });
  }
}

const team = teamOverview?.team ?? null;
const surveyRuns = teamOverview?.surveyRuns ?? [];
const isTeamLead = teamOverview?.isTeamLead ?? false;
const capabilityTrends = teamTrend?.capabilityTrends ?? [];
const surveyCount = teamTrend?.surveyCount ?? 0;

const addTeamMemberResult = Astro.getActionResult(actions.addTeamMember);
const removeTeamMemberResult = Astro.getActionResult(actions.removeTeamMember);
const changeMemberRoleResult = Astro.getActionResult(actions.changeMemberRole);

const hasTeamManagementAction = !!(
  addTeamMemberResult ||
  removeTeamMemberResult ||
  changeMemberRoleResult
);

const breadcrumbs = team
  ? [{ label: 'Home', href: '/' }, { label: team.name }]
  : undefined;
---

<DefaultMainLayout title="Team Details" breadcrumbs={breadcrumbs}>
  <div class="space-y-6">
    {
      notAuthorized ? (
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <h1 class="card-title text-2xl">Access Denied</h1>
            <Alert type="warning">
              You do not have permission to view this team. Only team members
              can access this page.
            </Alert>
            <div class="card-actions justify-end">
              <a href="/" class="btn btn-primary">
                Back to Home
              </a>
            </div>
          </div>
        </div>
      ) : (
        team && (
          <div class="space-y-4">
            <div class="flex">
              <div class="flex-1 space-y-2">
                <h1 class="text-3xl font-bold">{team.name}</h1>
                {team.description && (
                  <p class="text-sm text-base-content/60">{team.description}</p>
                )}
              </div>
              <div class="dropdown dropdown-end">
                <div
                  tabindex="0"
                  role="button"
                  class="btn btn-ghost btn-square"
                  data-testid="team-options-button"
                >
                  <span class="iconify lucide--ellipsis-vertical" />
                </div>
                <ul
                  tabindex="0"
                  class="dropdown-content menu bg-base-100 rounded-box z-1 w-52 p-2 shadow-xl"
                >
                  {isTeamLead && (
                    <li>
                      <a href={`/teams/${team.id}/edit`} class="gap-2">
                        <span class="iconify lucide--edit" />
                        Edit team details
                      </a>
                    </li>
                  )}
                </ul>
              </div>
            </div>

            <div class="tabs tabs-border">
              <input
                type="radio"
                name="teams-tabs"
                class="tab"
                aria-label="Surveys"
                checked={!hasTeamManagementAction ? 'checked' : undefined}
              />
              <div class="tab-content border-base-300 bg-base-100 p-6">
                {surveyRuns.length === 0 ? (
                  <EmptyState icon="survey" title="No surveys yet">
                    {isTeamLead && (
                      <a
                        href={`/teams/${team.id}/surveys/new`}
                        class="btn btn-primary gap-2"
                      >
                        <span class="iconify lucide--plus" />
                        New Survey
                      </a>
                    )}
                  </EmptyState>
                ) : (
                  <>
                    {isTeamLead && (
                      <div class="flex justify-end mb-4">
                        <a
                          href={`/teams/${team.id}/surveys/new`}
                          class="btn btn-primary gap-2"
                        >
                          <span class="iconify lucide--plus" />
                          New Survey
                        </a>
                      </div>
                    )}
                    <ul class="space-y-2">
                      {surveyRuns.map((run) => (
                        <li>
                          <a
                            href={`/teams/${team.id}/surveys/${run.id}`}
                            data-testid="survey-run-link"
                            class="flex items-center justify-between hover:bg-base-200 -mx-4 px-4 py-2 rounded-lg transition-colors"
                          >
                            <span>{run.title}</span>
                            <span class="badge badge-soft badge-info">
                              {run.status}
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                )}
              </div>

              <input
                type="radio"
                name="teams-tabs"
                class="tab"
                aria-label="Trend"
              />
              <div class="tab-content border-base-300 bg-base-100 p-6">
                {surveyCount === 0 ? (
                  <EmptyState
                    icon="survey"
                    title="No completed surveys yet"
                    message="Close a survey run to start building trend data."
                  />
                ) : (
                  <>
                    <TrendGrid doraCapabilityTrends={capabilityTrends} />
                  </>
                )}
              </div>

              <input
                type="radio"
                name="teams-tabs"
                class="tab"
                aria-label="Members"
                checked={hasTeamManagementAction ? 'checked' : undefined}
              />
              <div class="tab-content border-base-300 bg-base-100 p-6 space-y-4">
                {isTeamLead && (
                  <div class="flex flex-col">
                    <div class="flex justify-end">
                      {addTeamMemberResult?.error && (
                        <Alert type="error" class="mb-4">
                          {addTeamMemberResult.error.message}
                        </Alert>
                      )}
                      {removeTeamMemberResult?.error && (
                        <Alert type="error" class="mb-4">
                          {removeTeamMemberResult.error.message}
                        </Alert>
                      )}
                      {changeMemberRoleResult?.error && (
                        <Alert type="error" class="mb-4">
                          {changeMemberRoleResult.error.message}
                        </Alert>
                      )}
                    </div>
                    <div
                      class="join flex justify-end"
                      data-testid="add-team-member-form-container"
                    >
                      <form
                        method="POST"
                        id="add-team-member-form"
                        aria-label="Add Team Member Form"
                        action={actions.addTeamMember}
                        class="w-64"
                      >
                        <input type="hidden" name="teamId" value={team.id} />
                        <label class="input validator join-item">
                          <input
                            type="email"
                            id="teamMemberEmail"
                            name="teamMemberEmail"
                            required
                            placeholder="Email address"
                          />
                        </label>
                        <div class="validator-hint hidden">
                          Enter a valid email address
                        </div>
                      </form>
                      <button
                        type="submit"
                        form="add-team-member-form"
                        class="btn btn-primary join-item"
                      >
                        Add
                      </button>
                    </div>
                  </div>
                )}
                <ul class="space-y-2">
                  {team.members.map((member) => {
                    return (
                      <li class="flex items-center py-2">
                        <span class="flex-1">{member.userEmail}</span>
                        <span class="badge badge-soft badge-info">
                          {member.role === 'team-lead' ? 'Team Lead' : 'Member'}
                        </span>
                        {isTeamLead && (
                          <div class="dropdown dropdown-end">
                            <div
                              tabindex="0"
                              role="button"
                              class="btn btn-ghost btn-square"
                              data-testid="team-member-options-button"
                            >
                              <span class="iconify lucide--ellipsis-vertical" />
                            </div>
                            <ul
                              tabindex="0"
                              class="dropdown-content menu bg-base-100 rounded-box z-1 p-2 shadow-xl"
                            >
                              <li>
                                {member.role === 'team-lead' ? (
                                  <form
                                    method="POST"
                                    action={actions.changeMemberRole}
                                  >
                                    <input
                                      type="hidden"
                                      name="teamId"
                                      value={team.id}
                                    />
                                    <input
                                      type="hidden"
                                      name="memberEmail"
                                      value={member.userEmail}
                                    />
                                    <input
                                      type="hidden"
                                      name="newRole"
                                      value="regular-member"
                                    />
                                    <button
                                      type="submit"
                                      class="flex items-center gap-2"
                                      data-testid={`demote-member-${member.userId}`}
                                    >
                                      <span class="iconify lucide--chevrons-up" />
                                      Demote
                                    </button>
                                  </form>
                                ) : (
                                  <form
                                    method="POST"
                                    action={actions.changeMemberRole}
                                  >
                                    <input
                                      type="hidden"
                                      name="teamId"
                                      value={team.id}
                                    />
                                    <input
                                      type="hidden"
                                      name="memberEmail"
                                      value={member.userEmail}
                                    />
                                    <input
                                      type="hidden"
                                      name="newRole"
                                      value="team-lead"
                                    />
                                    <button
                                      type="submit"
                                      class="flex items-center gap-2"
                                      data-testid={`promote-member-${member.userId}`}
                                    >
                                      <span class="iconify lucide--chevrons-up" />
                                      Promote
                                    </button>
                                  </form>
                                )}
                              </li>
                              <li>
                                <form
                                  method="POST"
                                  action={actions.removeTeamMember}
                                >
                                  <input
                                    type="hidden"
                                    name="teamId"
                                    value={team.id}
                                  />
                                  <input
                                    type="hidden"
                                    name="memberEmail"
                                    value={member.userEmail}
                                  />
                                  <button
                                    type="submit"
                                    class="flex items-center gap-2 text-warning"
                                    data-testid={`remove-member-${member.userId}`}
                                  >
                                    <span class="iconify lucide--x-circle" />
                                    Remove
                                  </button>
                                </form>
                              </li>
                            </ul>
                          </div>
                        )}
                      </li>
                    );
                  })}
                </ul>
              </div>
            </div>
          </div>
        )
      )
    }
  </div>
</DefaultMainLayout>
