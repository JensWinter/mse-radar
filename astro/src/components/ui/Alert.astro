---
type Props = {
  type: 'error' | 'success' | 'warning' | 'info';
  class?: string;
  messageClass?: string;
};

const { type, class: className = '', messageClass = '' } = Astro.props;

const alertClasses = {
  error: 'alert-error',
  success: 'alert-success',
  warning: 'alert-warning',
  info: 'alert-info',
};

const iconClasses = {
  error: 'iconify lucide--circle-alert',
  success: 'iconify lucide--circle-check',
  warning: 'iconify lucide--triangle-alert',
  info: 'iconify lucide--info',
};
---

<div class={`alert ${alertClasses[type]} ${className}`}>
  <span class={iconClasses[type]}></span>
  <span class={messageClass}>
    <slot />
  </span>
</div>
