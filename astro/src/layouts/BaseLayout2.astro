---
import '../styles/global.css';

type Props = {
  title: string;
};

const { title } = Astro.props as Props;

const { user } = Astro.locals;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>

  <body class="min-h-screen flex flex-col flex-1 bg-base-300">
    <div class="navbar bg-base-100 shadow-sm flex-none">
      <div class="navbar-start">
        <a class="btn btn-ghost text-xl" href="/" aria-label="Main page">MSE</a>
      </div>
      <div class="navbar-center hidden lg:flex"></div>
      <div class="navbar-end">
        <ul class="menu menu-horizontal gap-4">
          {
            !user && (
              <>
                <li>
                  <a href="/login">Log in</a>
                </li>
                <li>
                  <a href="/register">Register</a>
                </li>
              </>
            )
          }
          {
            user && (
              <>
                <li>
                  <a href="/teams/new" aria-label="Add a team">
                    <span class="iconify lucide--plus" />
                    <span class="hidden sm:inline">New Team</span>
                  </a>
                </li>
                <li data-testid="user-menu">
                  <details>
                    <summary>{user?.email}</summary>
                    <ul class="bg-base-100 rounded-t-none p-2">
                      <li>
                        <a href="/account">Account</a>
                      </li>
                      <li>
                        <button id="logout-button" type="button">
                          Sign out
                        </button>
                      </li>
                    </ul>
                  </details>
                </li>
              </>
            )
          }
        </ul>
      </div>
    </div>

    <main class="container mx-auto p-8">
        <slot />
    </main>
  </body>
</html>

<script>
  import { signOut } from '../lib/auth-client.ts';

  const logoutButton = document.querySelector(
    '#logout-button',
  ) as HTMLButtonElement;
  if (logoutButton) {
    logoutButton.onclick = async () => {
      await signOut({
        fetchOptions: {
          onSuccess: async () => {
            window.location.href = '/';
          },
        },
      });
    };
  }
</script>
